<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/css/style.css">
    <meta charset="UTF-8">
    <title>Results</title>
</head>
<body>

<h1>F1 Race Results</h1>

<table>
    <thead>
    <tr>
        <th>ID</th>
        <th>Grand Prix</th>
        <th>Driver</th>
        <th>Position</th>
        <th>Points</th>
        <th>Fastest Lap</th>
    </tr>
    </thead>
    <tbody>
    {{#results}}
        <tr>
            <td>{{id}}</td>
            <td>{{race.grandPrixName}}</td>
            <td>{{driver.firstName}} {{driver.lastName}}</td>
            <td>{{finishingPosition}}</td>
            <td>{{pointsEarned}}</td>
            <td>{{fastestLapTime}}</td>
        </tr>
    {{/results}}
    </tbody>
</table>

<br>
<a href="/results/add">Add a Result</a> |
<a href="/">Back to Home</a>

</body>
</html>